# ==============================================================================
# TrackIT Backend — Docker Environment Configuration Template
# Copy this to .env or pass directly to docker-compose:
#   docker compose --env-file .env.docker up -d
# ==============================================================================

# Application
APP_NAME=TrackIT Backend
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
API_PORT=8000

# PostgreSQL
POSTGRES_USER=trackit
POSTGRES_PASSWORD=trackit_secure_password
POSTGRES_DB=trackit
POSTGRES_PORT=5432

# Database Connection (automatically constructed by docker-compose, or explicit)
DATABASE_URL=postgresql+psycopg2://trackit:trackit_secure_password@db:5432/trackit

# Scheduler & Browser
HEADLESS=true
RUN_MODE=scheduler
SCRAPER_CRON_SCHEDULE=0 2 * * *

# ==============================================================================
# LLM Provider Keys (At least ONE required for automatic selector extraction)
# ==============================================================================
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Fallback Order (leave empty for automatic detection)
LLM_PROVIDER_CHAIN=groq,gemini
