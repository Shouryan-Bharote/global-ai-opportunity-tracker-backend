# ======================
# Application
# ======================

APP_NAME=TrackIT Backend
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=development
API_PORT=8000
CORS_ORIGINS=["*"]

# ======================
# LLM — Built-in Providers
# Fill in whichever key(s) you have. Leave the rest blank.
# ======================

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# NVIDIA NIM (api.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ======================
# LLM — Custom / Bring-Your-Own Provider
# Use for Ollama, Together AI, Anyscale, local endpoints, etc.
# CUSTOM_PROVIDER_NAME must be a LiteLLM-supported prefix (e.g. openai, together_ai)
# ======================

CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_PROVIDER_NAME=openai
CUSTOM_DEFAULT_MODEL=

# ======================
# LLM Fallback Chain (optional)
# Comma-separated, ordered list of providers to try before giving up.
# If empty, auto-detects from whichever keys above are set.
# Example: LLM_PROVIDER_CHAIN=groq,nvidia,gemini
# ======================

LLM_PROVIDER_CHAIN=

# ======================
# Database
# Default: SQLite for local dev
# Production: postgresql+psycopg2://user:password@host:5432/dbname
# ======================

DATABASE_URL=sqlite:///./opportunities.db
# DATABASE_URL=postgresql+psycopg2://trackit:trackit_secret@localhost:5432/trackit

# ======================
# Browser & Scheduler
# ======================

HEADLESS=True
RUN_MODE=scheduler
SCRAPER_CRON_SCHEDULE=0 2 * * *
